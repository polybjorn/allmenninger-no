---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { locales, pathFor } from '../i18n/locales.js';
import logo from '../assets/logo.svg';

const { entry, lang } = Astro.props;
const { data } = entry;
// The Om section is the one piece of flowing prose, so it is the markdown body.
const { Content } = await render(entry);

// Frontmatter names photos by filename; Astro needs the import to optimise
// them, so resolve each name against the asset directory here.
const photos = import.meta.glob('../assets/*.jpg', { eager: true, import: 'default' });
const photo = (name) => {
  const img = photos[`../assets/${name}`];
  if (!img) throw new Error(`Missing asset: ${name}`);
  return img;
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The switcher and the hreflang tags list the languages that actually built,
// not the ones the registry declares. The route skips a locale with no content
// file, so reading locales.js here would link the header at a page that is not
// there - the registry is allowed to run ahead of the copy.
const built = new Set((await getCollection('pages')).map((e) => e.id.split('/')[0]));
const available = locales.filter((l) => built.has(l.code));
const others = available.filter((l) => l.code !== lang);
---

<Layout title={data.title} description={data.description} lang={lang} alternates={available}>
  <a href="#main" class="skip-link">{data.skipLink}</a>
  <header>
    <nav class="wrap">
      <a class="brand" href="#top"><img class="brand-logo" src={logo.src} width={logo.width} height={logo.height} alt="Allmenninger logo" /></a>
      <div class="navlinks">
        {data.nav.map(({ href, label }) => <a href={href}>{label}</a>)}
      </div>
      <div class="langswitch">
        {others.map((l) => (
          <a href={`${base}${pathFor(l.code)}`} hreflang={l.code} lang={l.code}>{l.label}</a>
        ))}
      </div>
    </nav>
  </header>

  <div id="top"></div>
  <main id="main" tabindex="-1">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-actions">
        <div class="eyebrow">{data.hero.eyebrow}</div>
        <h1>{data.hero.heading}</h1>
        <p class="lead">{data.hero.lead}</p>
        {data.hero.actions.map((a, i) => (
          <a class={i === 0 ? 'btn' : 'btn ghost'} href={a.href}>{a.label}</a>
        ))}
      </div>
      <div class="hero-media">
        <Image src={photo(data.hero.image.src)} alt={data.hero.image.alt} widths={[600, 900, 1200]} sizes="(max-width: 800px) 100vw, 45vw" loading="eager" />
        <div class="cap">{data.hero.caption}</div>
      </div>
    </div>
  </section>

  <section id="tenester">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">{data.services.kicker}</div>
        <h2>{data.services.heading}</h2>
        <p>{data.services.intro}</p>
      </div>
      <div class="services">
        {data.services.items.map((item) => (
          <div class="card">
            <div class:list={['card-media', { illustration: !item.image }]}>
              {item.image ? (
                <Image src={photo(item.image.src)} alt={item.image.alt} widths={[400, 700]} sizes="(max-width: 800px) 100vw, 33vw" />
              ) : (
                <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#f1efe6" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 16h34a6 6 0 0 1 6 6v10a6 6 0 0 1-6 6H26l-9 8v-8h-7a6 6 0 0 1-6-6V22a6 6 0 0 1 6-6Z"/>
                  <path d="M27 30c0-5 4-8 8-8-1 5-3 6-3 6s6-1 8 4c-4 3-9 2-9 2s3 3 1 7c-5-1-6-5-6-5"/>
                </svg>
              )}
            </div>
            <div class="card-body">
              <span class="num">{item.num}</span>
              <h3>{item.title}</h3>
              <p>{item.lead}</p>
              <ul>{item.points.map((p) => <li>{p}</li>)}</ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="om">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">{data.about.kicker}</div>
        <h2>{data.about.heading}</h2>
      </div>
      <div class="about">
        <div>
          <div class="about-media">
            <Image src={photo(data.about.image.src)} alt={data.about.image.alt} widths={[400, 700]} sizes="(max-width: 800px) 100vw, 30vw" />
          </div>
          {data.about.facts.map((f) => (
            <div class="fact">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
        <div><Content /></div>
      </div>
    </div>
  </section>

  <section id="prosjekt">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">{data.projects.kicker}</div>
        <h2>{data.projects.heading}</h2>
        <p>{data.projects.intro}</p>
      </div>
      <div class="timeline">
        {data.projects.items.map((item) => (
          <div class="tl-item">
            <div class="year">{item.year}</div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="galleri">
    <div class="wrap">
      <div class="section-head">
        <div class="kicker">{data.gallery.kicker}</div>
        <h2>{data.gallery.heading}</h2>
        <p>{data.gallery.intro}</p>
      </div>
      <div class="gallery">
        {data.gallery.items.map((item) => (
          <figure class:list={[{ tall: item.tall }]}>
            <Image src={photo(item.image.src)} alt={item.image.alt} widths={[400, 700]} sizes="(max-width: 800px) 50vw, 25vw" />
            <figcaption>{item.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" id="kontakt">
    <div class="wrap">
      <div class="contact-box">
        <div>
          <h2>{data.contact.heading}</h2>
          <p>{data.contact.body}</p>
        </div>
        <a class="btn" href={`mailto:${data.contact.email}`}>{data.contact.email}</a>
      </div>
    </div>
  </section>

  </main>

  <footer>
    <div class="wrap">{data.footer}</div>
  </footer>
</Layout>
