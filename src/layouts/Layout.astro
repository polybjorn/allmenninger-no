---
interface Props {
  title: string;
  description: string;
  lang?: string;
  // The languages that actually built, passed down rather than read from the
  // registry: hreflang must not advertise a locale whose page does not exist.
  alternates: { code: string }[];
}

import '../styles/global.css';
import { localeInfo, defaultLocale, pathFor } from '../i18n/locales.js';

const { title, description, lang = defaultLocale, alternates } = Astro.props;
const info = localeInfo(lang);
const site = (Astro.site?.href ?? 'https://allmenninger.no/').replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Keep the preview out of search indexes so it never competes with the live
// Netlify site; disappears on its own once `site` is allmenninger.no again.
const isPreview = !site.includes('allmenninger.no');
const canonical = `${site}${Astro.url.pathname}`;
---

<!DOCTYPE html>
<html lang={lang} dir={info.dir}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`}>
  <link rel="canonical" href={canonical}>
  {!isPreview && <link rel="sitemap" href={`${base}/sitemap-index.xml`} />}
  {isPreview && <meta name="robots" content="noindex" />}
  {alternates.map((l) => (
    <link rel="alternate" hreflang={l.code} href={`${site}${base}${pathFor(l.code)}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${site}${base}${pathFor(defaultLocale)}`} />
  <meta property="og:site_name" content="Allmenninger">
  <meta property="og:type" content="website">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={info.og}>
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'self'; form-action 'self'">
  <meta name="referrer" content="no-referrer">
</head>
<body>
  <slot />
</body>
</html>
